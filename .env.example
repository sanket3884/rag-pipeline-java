# Required only when EMBEDDING_MODE=openai,etc.
OPENAI_API_KEY=

# Required only when LLM_MODE=anthropic,openai,etc.
ANTHROPIC_API_KEY=

# Component switches — see Main.java for details. Defaults shown.
EMBEDDING_MODE=hashing      # hashing | openai
VECTOR_STORE_MODE=memory    # memory | lucene
LLM_MODE=mock               # mock | anthropic
